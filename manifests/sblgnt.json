  "input_format": {
    "text": "data/sblgnt/text/{OSIS_BOOK}.txt",
    "xml": "data/sblgnt/xml/{OSIS_BOOK}.xml",
    "text_use": "Authoritative displayed verse text, including all original punctuation and accents.",
    "xml_use": "Independent Greek lexical comparison, verse inventory, source references, word counts, and paragraph membership."
  },
  "preparation": {
    "module": "bibleprep.greek",
    "version": 1,
    "unicode_normalization": "none",
    "source_text": "Exact source verse payload after the tab, excluding line ending; includes trailing source layout spaces and apparatus markers.",
    "text": "Remove apparatus-anchor symbols and attached numeric disambiguators; trim boundary layout whitespace. Retain Greek spelling, interior spacing, punctuation, and both kinds of editorial brackets.",
    "main_text": "Remove double-bracketed supplements only. Retain doubtful single-bracketed wording and its brackets; this is not a new critical edition.",
    "alternatives": "Double-bracketed material stored as verse fragments sharing a group_id; emit each group as a separately identified supplement if used in training.",
    "editorial_spans": "Single/double bracket ranges tracked across verses and chapters; offsets are zero-based Unicode code-point indices in text, with exclusive end.",
    "missing_verses": "Keep source numbering gaps. Do not manufacture empty verses or borrow text from another edition.",
    "paragraphs": "XML paragraph numbers with per-verse word-index ranges; do not assume every paragraph boundary falls on a verse boundary.",
    "excluded_layers": [
      "Edition-comparison apparatus notes in data/sblgntapp (not imported as verse text)."
    ],
    "editorial_evidence": [
      "https://sblgnt.com/about/introduction/",
      "https://github.com/Faithlife/SBLGNT/blob/c4d241a9c1c479a55b989ba35a4976c1d0b8052c/data/sblgnt/text/Mark.txt",
      "https://github.com/Faithlife/SBLGNT/blob/c4d241a9c1c479a55b989ba35a4976c1d0b8052c/data/sblgnt/text/John.txt"
    ],
    "limitations": [
      "SBLGNT is a modern critical edition, not an ancient manuscript or a recovered autograph.",
      "The apparatus compares editions; this preparation does not import a manuscript apparatus.",
      "Internal missing-number reports cannot identify a verse absent beyond a chapter's last source number. Chapter maxima belong to SBLGNT versification."
    ]
  },
