# Copy to .env at the repository root and fill only the provider key you use.
# .env is ignored by Git. Never paste credentials into project documents or chat.
# Explicit API execution loads this file; dry runs never read it.
# Existing exported variables take precedence. Values are not interpolated.
# Tinker is the planned training provider; the others are optional alternatives.
TINKER_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
