# Copy to .env at the repository root and fill only the provider key you use.
# .env is ignored by Git. Never paste credentials into project documents or chat.
# Explicit API execution loads this file; dry runs never read it.
# Existing exported variables take precedence. Values are not interpolated.
# Tinker is the planned training provider; the others are optional alternatives.
TINKER_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=

# Account access is disabled until email delivery and the rollout checks pass.
# The hosted application reads these from its process environment.
MEFORASH_PUBLIC_ACCESS=0
MEFORASH_EMAIL_LOGIN_ENABLED=0
MEFORASH_ACCOUNT_DAILY_LIMIT=20
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate once; preserve across restarts. Changing it invalidates guest identity.
MEFORASH_ACCESS_HMAC_SECRET=
# Enable only behind Railway's HTTPS proxy, after checking header replacement.
MEFORASH_TRUST_RAILWAY_REAL_IP=0
